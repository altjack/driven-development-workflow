{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feature-flow.local/schemas/workflow-v1.json",
  "title": "Feature Flow workflow configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "docs", "code", "e2e", "limits"],
  "properties": {
    "version": {
      "const": 1
    },
    "docs": {
      "$ref": "#/$defs/workflow"
    },
    "code": {
      "$ref": "#/$defs/workflow"
    },
    "e2e": {
      "$ref": "#/$defs/workflow"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_reviews"],
      "properties": {
        "max_reviews": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      }
    },
    "routing": {
      "$ref": "#/$defs/routing"
    }
  },
  "$defs": {
    "effort": {
      "enum": ["low", "medium", "high", "xhigh", "max", "ultra"]
    },
    "probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "tierEfforts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "reviewer"],
      "properties": {
        "author": {"$ref": "#/$defs/effort"},
        "reviewer": {"$ref": "#/$defs/effort"}
      }
    },
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["S", "M", "L", "XL"],
      "properties": {
        "S": {"$ref": "#/$defs/tierEfforts"},
        "M": {"$ref": "#/$defs/tierEfforts"},
        "L": {"$ref": "#/$defs/tierEfforts"},
        "XL": {"$ref": "#/$defs/tierEfforts"}
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "classifier",
        "formula_version",
        "min_confidence",
        "underestimate_budget",
        "risk_threshold",
        "rounds_threshold",
        "effort_by_tier",
        "reviewer_floor_on_risk"
      ],
      "properties": {
        "mode": {
          "enum": ["off", "shadow"]
        },
        "classifier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "model", "timeout_s"],
          "properties": {
            "provider": {"enum": ["openrouter"]},
            "model": {"type": "string", "minLength": 1},
            "timeout_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 60}
          }
        },
        "formula_version": {
          "const": 1
        },
        "min_confidence": {"$ref": "#/$defs/probability"},
        "underestimate_budget": {"$ref": "#/$defs/probability"},
        "risk_threshold": {"$ref": "#/$defs/probability"},
        "rounds_threshold": {"$ref": "#/$defs/probability"},
        "effort_by_tier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["docs", "code", "e2e"],
          "properties": {
            "docs": {"$ref": "#/$defs/tiers"},
            "code": {"$ref": "#/$defs/tiers"},
            "e2e": {"$ref": "#/$defs/tiers"}
          }
        },
        "reviewer_floor_on_risk": {"$ref": "#/$defs/effort"}
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "effort"],
      "properties": {
        "provider": {
          "enum": ["claude", "codex"]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "enum": ["low", "medium", "high", "xhigh", "max", "ultra"]
        },
        "sandbox": {
          "enum": ["read-only", "workspace-write", "danger-full-access"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provider": {
                "const": "codex"
              }
            },
            "required": ["provider"]
          },
          "then": {
            "required": ["sandbox"]
          },
          "else": {
            "not": {
              "required": ["sandbox"]
            }
          }
        }
      ]
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "provider", "model"],
      "properties": {
        "role": {
          "enum": ["author", "reviewer"]
        },
        "provider": {
          "enum": ["claude", "codex"]
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "reviewer"],
      "properties": {
        "author": {
          "$ref": "#/$defs/route"
        },
        "reviewer": {
          "$ref": "#/$defs/route"
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["on"],
      "properties": {
        "on": {
          "$ref": "#/$defs/trigger"
        },
        "to": {
          "$ref": "#/$defs/target"
        },
        "stop": {
          "const": "needs_user"
        }
      },
      "oneOf": [
        {
          "required": ["to"],
          "not": {
            "required": ["stop"]
          }
        },
        {
          "required": ["stop"],
          "not": {
            "required": ["to"]
          }
        }
      ]
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "reviewer", "fallbacks"],
      "properties": {
        "author": {
          "$ref": "#/$defs/route"
        },
        "reviewer": {
          "$ref": "#/$defs/route"
        },
        "fallbacks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transition"
          }
        }
      }
    }
  }
}
