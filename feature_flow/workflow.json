{
  "version": 1,
  "docs": {
    "author": {
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "effort": "xhigh",
      "sandbox": "workspace-write"
    },
    "reviewer": {
      "provider": "claude",
      "model": "claude-opus-5",
      "effort": "high"
    },
    "fallbacks": [
      {
        "on": {"role": "author", "provider": "codex", "model": "gpt-5.6-sol"},
        "to": {
          "author": {"provider": "codex", "model": "gpt-5.6-terra", "effort": "xhigh", "sandbox": "workspace-write"},
          "reviewer": {"provider": "claude", "model": "claude-opus-5", "effort": "high"}
        }
      },
      {
        "on": {"role": "reviewer", "provider": "claude", "model": "claude-opus-5"},
        "to": {
          "author": {"provider": "codex", "model": "gpt-5.6-sol", "effort": "xhigh", "sandbox": "workspace-write"},
          "reviewer": {"provider": "codex", "model": "gpt-5.6-terra", "effort": "xhigh", "sandbox": "read-only"}
        }
      },
      {
        "on": {"role": "author", "provider": "codex", "model": "gpt-5.6-terra"},
        "stop": "needs_user"
      },
      {
        "on": {"role": "reviewer", "provider": "codex", "model": "gpt-5.6-terra"},
        "stop": "needs_user"
      }
    ]
  },
  "code": {
    "author": {
      "provider": "codex",
      "model": "gpt-5.6-terra",
      "effort": "xhigh",
      "sandbox": "workspace-write"
    },
    "reviewer": {
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "effort": "high",
      "sandbox": "read-only"
    },
    "fallbacks": [
      {
        "on": {"role": "author", "provider": "codex", "model": "gpt-5.6-terra"},
        "stop": "needs_user"
      },
      {
        "on": {"role": "reviewer", "provider": "codex", "model": "gpt-5.6-sol"},
        "stop": "needs_user"
      }
    ]
  },
  "e2e": {
    "author": {
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "effort": "high",
      "sandbox": "workspace-write"
    },
    "reviewer": {
      "provider": "claude",
      "model": "claude-opus-5",
      "effort": "xhigh"
    },
    "fallbacks": [
      {
        "on": {"role": "author", "provider": "codex", "model": "gpt-5.6-sol"},
        "stop": "needs_user"
      },
      {
        "on": {"role": "reviewer", "provider": "claude", "model": "claude-opus-5"},
        "stop": "needs_user"
      }
    ]
  },
  "limits": {
    "max_reviews": 3
  },
  "routing": {
    "mode": "shadow",
    "classifier": {"provider": "openrouter", "model": "~typesafe/jev-latest", "timeout_s": 5},
    "formula_version": 1,
    "min_confidence": 0.7,
    "underestimate_budget": 0.25,
    "risk_threshold": 0.3,
    "rounds_threshold": 0.5,
    "effort_by_tier": {
      "docs": {
        "S": {"author": "medium", "reviewer": "high"},
        "M": {"author": "high", "reviewer": "high"},
        "L": {"author": "xhigh", "reviewer": "high"},
        "XL": {"author": "xhigh", "reviewer": "xhigh"}
      },
      "code": {
        "S": {"author": "medium", "reviewer": "high"},
        "M": {"author": "high", "reviewer": "high"},
        "L": {"author": "xhigh", "reviewer": "high"},
        "XL": {"author": "xhigh", "reviewer": "xhigh"}
      },
      "e2e": {
        "S": {"author": "medium", "reviewer": "high"},
        "M": {"author": "high", "reviewer": "high"},
        "L": {"author": "high", "reviewer": "xhigh"},
        "XL": {"author": "xhigh", "reviewer": "xhigh"}
      }
    },
    "reviewer_floor_on_risk": "xhigh"
  }
}
